<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local score cache database and persisted SAF folder URI grants from cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
