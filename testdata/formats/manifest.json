{
  "schema": 1,
  "description": "Supported-format contract and conformance corpus shared by every product's tests. Human documentation: docs/shared/SUPPORTED_FORMATS.md. Change it only together with every product's implementation.",
  "corpus": {
    "cache_env": "PST_FORMAT_CORPUS",
    "require_env": "PST_REQUIRE_FORMAT_CORPUS",
    "default_cache_dir": "~/.cache/photo-selector-toolbox/format-corpus",
    "fetch_script": "scripts/fetch_format_corpus.py",
    "mirrors": [
      "https://github.com/alexpp90/photo-selector/releases/download/format-corpus-v1/{file}"
    ],
    "license": "CC0-1.0 (raw.pixls.us); the per-sample url is the canonical origin and the last fallback"
  },
  "display": {
    "min_long_edge_px": 1024,
    "note": "A display decode of every required sample must reach min(min_long_edge_px, expect.long_edge_px), the latter being the native long edge. RAW files may use their embedded preview but must fall back to a real decode when the preview is smaller (phone DNGs embed ~672 px previews)."
  },
  "exif_tolerance": {
    "relative": 0.02,
    "note": "Exposure time, f-number and focal length match within this relative tolerance; ISO matches exactly. Make, model and lens compare case-insensitively after trimming whitespace (some cameras pad these fields with spaces)."
  },
