{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lab Finding",
  "type": "object",
  "required": [
    "id",
    "source",
    "product",
    "config",
    "journey",
    "checkpoint",
    "rule",
    "severity",
    "confidence",
    "region",
    "message",
    "evidence",
    "new_since_last_run"
  ],
  "properties": {
    "id": {"type": "string"},
    "source": {
      "type": "string",
      "enum": ["layout-lint", "fs-oracle", "timing", "log", "flow", "ai-review", "ai-explorer"]
    },
    "product": {
      "type": "string",
      "enum": ["phototok", "android-desktop", "macos", "linux"]
    },
    "config": {"type": "string"},
    "journey": {"type": "string"},
    "checkpoint": {"type": "string"},
    "rule": {"type": "string"},
    "severity": {
      "type": "string",
      "enum": ["blocker", "major", "minor", "polish"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "region": {
      "type": ["array", "null"],
      "items": {"type": "number"},
      "minItems": 4,
      "maxItems": 4
    },
    "message": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "new_since_last_run": {"type": "boolean"}
  }
}
